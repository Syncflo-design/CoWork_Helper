{"nodes": [{"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "label": "Print format PDF margins come from .print-format CSS", "file_type": "document", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_css_margin_rule", "label": ".print-format CSS margin rule", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frappe copies margin-* from the CSS rule whose selector is exactly .print-format into the PDF options, overriding the Print Format margin fields."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_margin_fields", "label": "Print Format margin fields", "file_type": "concept", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Save fine and look authoritative, but have no effect once the CSS rule sets the margins."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_repeating_letterhead", "label": "Repeating letterhead in the top margin", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawn in the top margin, bottom-aligned to the margin line; anything in the header box below the logo spills past the line and paints white over the body."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_letterhead_css_fix", "label": "Verified letterhead and margin CSS fix", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "margin-top 34mm is the 80px logo plus about 12mm white space; no margin-bottom in the .print-format rule, because that brought back the overlap and a blank second page."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_download_pdf_chrome_verification", "label": "Verify PDF through download_pdf in signed-in Chrome", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The MCP download_pdf result is text-decoded and corrupt, so inspect the real PDF in Chrome and test each change rather than reasoning on paper."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_item_amount_not_net_amount", "label": "Line Amount uses item.amount, not item.net_amount", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "net_amount already has the document-level discount spread in, so printing it beside a Discount row double-counts."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_2026_quotation_invoice_print_formats", "label": "2026 Quotation and 2026 Invoice print formats", "file_type": "concept", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_css_margin_rule", "relation": "references", "confidence": "EXTRACTED"