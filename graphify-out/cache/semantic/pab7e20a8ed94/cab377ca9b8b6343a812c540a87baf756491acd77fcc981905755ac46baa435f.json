{"nodes": [{"id": "gotchas_2026_11_06_list_onload_filter_narrows_fresh_drilldown", "label": "List onload filter narrows fresh drill-down", "file_type": "document", "source_file": "gotchas/2026-11-06-list-onload-filter-narrows-fresh-drilldown.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_06_list_onload_filter_narrows_fresh_drilldown_list_onload_default_filter", "label": "Default filter added in list onload", "file_type": "rationale", "source_file": "gotchas/2026-11-06-list-onload-filter-narrows-fresh-drilldown.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onload runs only when the list view is first built, so the bug shows only when a drill-down is the first open after a page load."}, {"id": "gotchas_2026_11_06_list_onload_filter_narrows_fresh_drilldown_route_options_filter_overlap", "label": "frappe.route_options overlap on first list build", "file_type": "rationale", "source_file": "gotchas/2026-11-06-list-onload-filter-narrows-fresh-drilldown.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "filter_area.add() overlaps the clear and set the list does for pending route options, so some added conditions survive."}, {"id": "gotchas_2026_11_06_list_onload_filter_narrows_fresh_drilldown_skip_filter_when_route_options", "label": "Skip default filter when arriving with route options", "file_type": "rationale", "source_file": "gotchas/2026-11-06-list-onload-filter-narrows-fresh-drilldown.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check for an empty object, not just falsy."}, {"id": "gotchas_2026_11_06_list_onload_filter_narrows_fresh_drilldown_sales_invoice_hide_cancelled", "label": "Sales Invoice - Hide Cancelled Client Script", "file_type": "concept", "source_