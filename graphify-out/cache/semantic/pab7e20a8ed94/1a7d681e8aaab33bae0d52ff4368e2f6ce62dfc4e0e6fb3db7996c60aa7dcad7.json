{"nodes": [{"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull", "label": "Ardmore first live stock pull gotcha", "file_type": "document", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_fractional_qty_whole_number_uom", "label": "Fractional Sage quantity on whole-number UOM", "file_type": "concept", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L7-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sage Home held half units (e.g. 153.5 napkins) on items whose ERPNext UOM is each; fix rounds the Sage quantity DOWN because only fabrics in Meter take decimals."}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_negative_sage_average_cost", "label": "Negative Sage average cost", "file_type": "concept", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L11-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items with no custom_item_cost fall back to Sage averageCost, which can be negative; a negative valuation now goes in at 0."}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_stock_reconciliation_batch_failure", "label": "One bad line fails the whole 25-line Stock Reconciliation batch", "file_type": "concept", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L8-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single fractional or negative-cost line took 24 good items with it; 350 of 1,320 Home lines were missing after the first run."}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_pharoh_selectionid_batch_cap", "label": "Pharoh selectionid lookup fails at 25+ codes per call", "file_type": "concept", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L13-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works at 10, returns nothing at 25 yet reports a complete answer, so align listed 450 real Home items as not in Sage; align changed to 10 codes per call."}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_fabric_uom_meter_change", "label": "Seven fabrics changed from each to Meter UOM", "file_type": "concept", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L22-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FABCDOD and FABDRALON variants changed before they held stock, because a UOM cannot change once stock exists."}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_tmp_compare_sage_stock", "label": "tmp-compare-sage-stock temporary API script", "file_type": "code", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L28-30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_01_ardmore_first_live_stock_pull_presync_sage_data_check", "label": "Check Sage data and Pharoh batch size before switching stock sync on", "file_type": "rationale", "source_file": "gotchas/2026-11-01-ardmore-first-live-stock-pull.md", "source_location": "L34-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Look for fractional quantities on whole-number UOMs and negative average costs in Sage first; never trust a Pharoh batch lookup without testing the batch size it actually handles."}], "edges": [{"source": "gotchas_2026_11_01_ardmore_first_live_stock_pull", "target": "gotchas_2026_11_01_ardmore_first_live_stock_pull_fractional_qty_whole_number_uom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-11-