oncept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L7-L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sage Business Cloud stores a company's default price list on the item itself, not as an additional price list. Affected: Home 'Retail Price' 130577, Ceramics 'Wholesale' 130535, Fashion 'Retail - Local'."}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_sage_business_cloud", "label": "Sage Business Cloud", "file_type": "concept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_standard_rate_incl", "label": "standard_rate_incl (item default price)", "file_type": "concept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L8,L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_pharoh_inventory_feed", "label": "Pharoh inventory feed", "file_type": "concept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L8,L16-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paged with lastDate=1970-01-01&InclZeroOnHand=true to get every item's standard_rate_incl."}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_additionalitempricessync", "label": "AdditionalItemPricesSync (Sage endpoint)", "file_type": "concept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L8-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns only non-default price lists, so default lists never come through it."}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_get_additional_prices_for_erpnext", "label": "get-additional-prices-for-erpnext (Server Script)", "file_type": "code", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L9-L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_get_inventory_for_erpnext", "label": "get-inventory-for-erpnext (Server Script)", "file_type": "code", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_ardmore_retail", "label": "Ardmore - Retail (ERPNext price list)", "file_type": "concept", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second trap: filled with the standard price of the item's OWN category company only; Ceramics' default list is Wholesale, so Ceramics-category items carry roughly half the retail price here."}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_sync_home_retail_prices", "label": "sync-home-retail-prices (Server Script, Daily Long)", "file_type": "code", "source_file": "gotchas/2026-11-02-sage-default-price-list-empty-in-erpnext.md", "source_location": "L16-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fix: pages the Home inventory feed and upserts every item's standard_rate_incl into Home - Retail Price, bypassing AdditionalItemPricesSync which never returns default lists. Run on demand from Scheduled Job Type -> Execute."}, {"id": "gotchas_2026_11_02_sage_default_price_list_empty_in_erpnext_auto_insert_price_list