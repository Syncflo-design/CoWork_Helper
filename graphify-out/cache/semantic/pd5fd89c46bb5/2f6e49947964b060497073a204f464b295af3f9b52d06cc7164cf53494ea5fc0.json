{"nodes": [{"id": "gotchas_2026_06_10_server_script_sandbox_and_xlsx", "label": "Server Script safe_exec sandbox limits + reading .xlsx", "file_type": "document", "source_file": "gotchas/2026-06-10-server-script-sandbox-and-xlsx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_06_10_server_script_sandbox_and_xlsx_safe_exec_sandbox", "label": "Server Script safe_exec (RestrictedPython) sandbox", "file_type": "rationale", "source_file": "gotchas/2026-06-10-server-script-sandbox-and-xlsx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks imports (so no .xlsx), names starting with _, commit/rollback in DocType Event scripts, tuple unpacking, frappe.parse_json, str.format; errors surface only when the script runs, never on save."}, {"id": "gotchas_2026_06_10_server_script_sandbox_and_xlsx_function_scope_limitation", "label": "Server Script functions cannot see script-level names", "file_type": "concept", "source_file": "gotchas/2026-06-10-server-script-sandbox-and-xlsx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "safe_exec puts doc and top-level defs in _locals while a def captures _globals, so one helper cannot call another or read doc; pass as arguments or inline."}, {"id": "gotchas_2026_06_10_server_script_sandbox_and_xlsx_nest_sheets_app", "label": "nest_sheets app (read_sheet API)", "file_type": "concept", "source_file": "gotchas/2026-06-10-server-script-sandbox-and-xlsx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-Python app reads xlsx/delimited files because the sandbox cannot; Client Script stores rows in sheet_data on attach so the one user action is Save."}, {"id": "gotchas_2026_06_10_server_script_sandbox_and_xlsx_execute_after_edit_rule", "label":