{"nodes": [{"id": "gotchas_2026_08_12_price_list_holding_two_vat_conventions_at_once", "label": "Gotcha: one price list holding two VAT conventions at once", "file_type": "document", "source_file": "gotchas/2026-08-12-price-list-holding-two-vat-conventions-at-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two individually correct processes wrote ex-VAT and incl-VAT figures to the same price list, so the till price depended on who wrote last; the fault only exists in the overlap."}, {"id": "gotchas_2026_08_12_price_list_holding_two_vat_conventions_at_once_get_additional_prices_for_erpnext", "label": "get-additional-prices-for-erpnext (Sage price sync)", "file_type": "code", "source_file": "gotchas/2026-08-12-price-list-holding-two-vat-conventions-at-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_08_12_price_list_holding_two_vat_conventions_at_once_kiln_home_fashion_importers", "label": "Kiln Sheet / Home Fashion importers", "file_type": "code", "source_file": "gotchas/2026-08-12-price-list-holding-two-vat-conventions-at-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_08_12_price_list_holding_two_vat_conventions_at_once_included_in_print_rate", "label": "included_in_print_rate = 1 on every VAT template", "file_type": "rationale", "source_file": "gotchas/2026-08-12-price-list-holding-two-vat-conventions-at-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ardmore prices goods including VAT in round numbers and the till must ring exactly that, so the list rate is the incl figure and VAT is extracted from within it."}, {"id": "gotchas_2026_08_12_price_list_holding_two_vat_conventions_at_once_gross_sage_sync_up_by_1_15", "label": "Gross the Sage 