{"nodes": [{"id": "gotchas_2026_09_29_sage_returns_and_retry", "label": "Gotcha: Sage returns and retry", "file_type": "document", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_retry_failed_sage_sync", "label": "retry-failed-sage-sync Scheduler Server Script", "file_type": "concept", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the same posting script via execute_doc so there is one posting routine and one lock; max 8 attempts, 15 per run, sales before returns."}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_send_to_sage_button", "label": "ardmore-send-invoice-to-sage API and Send to Sage button", "file_type": "concept", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_sage_sync_statuses", "label": "Sage sync statuses: Synced / Failed / Check Sage", "file_type": "rationale", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check Sage is never auto-retried because the connection dropped after sending and a resend could create a duplicate."}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_no_copy_sage_fields", "label": "Sage custom fields set no_copy", "file_type": "rationale", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERPNext copies custom fields from a sale onto its return unless no_copy, so returns falsely showed Synced with the sale's Sage ids."}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_api_key_redaction", "label": "Pharoh API key and password redaction in errors", "file_type": "rationale", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Pharoh API key is in the request URL so HTTP errors contain it; the Error Log used to receive the full payload including the login password."}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_execute_doc_pattern", "label": "Server Script execute_doc runs another Server Script", "file_type": "rationale", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_29_sage_returns_and_retry_sales_rep_per_company", "label": "custom_sage_pos_sales_rep_id on Company Sage Integration", "file_type": "rationale", "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sage refuses a customer return without a sales rep, and rep ids belong to one Sage company, so the id is held per company."}], "edges": [{"source": "gotchas_2026_09_29_sage_returns_and_retry", "target": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_ardmoreceramics_site", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_29_sage_returns_and_retry", "target": "gotchas_2026_09_29_sage_returns_and_retry_retry_failed_sage_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-29-sage-returns-and-retry.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_