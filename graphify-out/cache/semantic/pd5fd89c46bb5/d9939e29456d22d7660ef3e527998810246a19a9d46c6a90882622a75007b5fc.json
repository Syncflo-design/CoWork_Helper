{"nodes": [{"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate", "label": "Gotcha: Insights fork sqlglot pin breaks Frappe migrate", "file_type": "document", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_insights_fork", "label": "Syncflo-design/insights fork (syncflo-custom-theme)", "file_type": "concept", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen at Insights 3.12.2 plus three Syncflo commits; rebasing onto current version-3 would end this class of failure. Carried by Ardmore and Blomo."}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_sqlglot_pin", "label": "sqlglot pin >=30.12.0,<30.18", "file_type": "rationale", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frappe's sql_metadata 3.x needs sqlglot>=30.12; the <30.18 ceiling avoids a Drop change that breaks DuckDB create_table(overwrite) and CSV import in Insights."}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_sql_metadata", "label": "sql_metadata 3.x (Frappe core dependency)", "file_type": "concept", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_pip_last_writer_wins", "label": "pip last-writer-wins across bench apps", "file_type": "rationale", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each app install only satisfies its own pins, so an app installed after Frappe can downgrade a Frappe dependency."}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_frappe_cloud_recovered_status", "label": "Frappe Cloud Site > Updates 'Recovered' status", "file_type": "rationale", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bench Deploys = Success only means the image built; Recovered means migrate failed and the site rolled back, so check Site > Updates after every deploy."}, {"id": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_upstream_pin_check", "label": "Compare fork pins with upstream pyproject files", "file_type": "concept", "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate", "target": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_ardmoreceramics_site", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate", "target": "gotchas_2026_09_29_insights_fork_sqlglot_pin_breaks_frappe_migrate_insights_fork", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-29-insights-fork-sqlglot-pin-breaks-frappe-migrate.md", "source_location": null, "weight": 1.0}, {"sou