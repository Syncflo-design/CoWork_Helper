{"nodes": [{"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "label": "Gotcha: print format PDF margins come from .print-format CSS", "file_type": "document", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_css_margins", "label": ".print-format CSS rule supplies PDF margins", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frappe copies margin-* from the CSS rule whose selector is exactly .print-format into the PDF options, overriding the Print Format margin fields."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_repeating_letterhead", "label": "Repeating letterhead drawn in the top margin", "file_type": "concept", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is bottom-aligned to the margin line, so any margin below the logo spills over the body; no margin-bottom in the .print-format rule."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_download_pdf_chrome_verify", "label": "Verify PDFs via download_pdf in signed-in Chrome", "file_type": "rationale", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The MCP download_pdf result is text-decoded and corrupt; test each change on the real PDF."}, {"id": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_item_amount_vs_net_amount", "label": "Line Amount uses item.amount, not net_amount", "file_type": "concept", "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "net_amount already has the document discount spread in, so printing it with a discount row double-counts."}], "edges": [{"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_css_margins", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_repeating_letterhead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_download_pdf_chrome_verify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_item_amount_vs_net_amount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "gotchas/2026-09-30-print-format-pdf-margins-come-from-css.md", "source_location": null, "weight": 1.0}, {"source": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_print_format_css_margins", "target": "gotchas_2026_09_30_print_format_pdf_margins_come_from_css_repeating_letterhead", 