{"nodes": [{"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo", "label": "Gotcha: disabled default price list and stale bootinfo cache", "file_type": "document", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_ardmoreceramics_site", "label": "ardmoreceramics.c.frappe.cloud (Ardmore site)", "file_type": "concept", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_selling_settings_default_price_list", "label": "Selling Settings Default Price List", "file_type": "concept", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERPNext client code seeds selling_price_list from frappe.sys_defaults (boot) before the POS Profile list applies; pointing it at a disabled list pops an error on every POS return. Set it to any enabled ZAR list since POS Profiles override it."}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_standard_selling_price_list", "label": "Standard Selling price list (disabled)", "file_type": "concept", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately disabled 2026-07-28 because Ardmore prices per company list."}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_apply_price_list", "label": "erpnext.stock.get_item_details.apply_price_list", "file_type": "concept", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_bootinfo_redis_cache", "label": "Frappe v16 per-user bootinfo redis cache", "file_type": "rationale", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving Selling Settings does not clear the cached boot; clear it by saving the User record (clear_user_cache), the user's own Clear Cache, or a System Settings save for site-wide, then open a new tab because a POS tab with a draft blocks reload."}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_api_server_script_diagnostic", "label": "Throw-away API Server Script to read server state", "file_type": "rationale", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "frappe.client.get_default/set_default are gone in v16, DefaultValue is not listable by the API user, and frappe.cache / clear_cache are not exposed in safe_exec; clear caches by saving documents whose hooks clear them."}, {"id": "gotchas_2026_09_07_disabled_default_price_list_and_stale_bootinfo_pos_profiles_on_disabled_list", "label": "POS Profiles Airport/Caversham/Joburg on disabled Standard Selling", "file_type": "concept", "source_file": "gotchas/2026-09-07-disabled-default-price-list-and-stale-bootinfo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Still open: each store's real price list needs Ardmore's decision; do not guess."}], "edges": [{"source": "gotchas_2026_09_07_disab